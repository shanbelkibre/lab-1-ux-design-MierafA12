<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <!-- Top Toolbar Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <!-- Search Input Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="name"
                android:background="@null"
                android:hint="@string/search_hint"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnClear"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/cd_clear"
                android:src="@drawable/ic_clear" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/cd_menu"
            android:src="@drawable/ic_menu" />
    </LinearLayout>

    <!-- Filter Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_tab_unselected"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/chip_translation"
            android:textColor="@color/primary_cyan"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tab_unselected"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/chip_fiction"
            android:textColor="@color/primary_cyan"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Search Results Count Text -->
    <TextView
        android:id="@+id/tvResultsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingVertical="4dp"
        android:text="@string/search_results_count"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Results List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_book_search_result" />
            <include layout="@layout/item_book_search_result" />
            <include layout="@layout/item_book_search_result" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>