<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_rounded"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Book Cover Image -->
    <ImageView
        android:id="@+id/ivSearchResultCover"
        android:layout_width="70dp"
        android:layout_height="90dp"
        android:contentDescription="@string/sample_book_title"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_book_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvBookTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_book_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Author -->
        <TextView
            android:id="@+id/tvBookAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sample_book_author"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Yellow Rating Stars -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Star"
                android:src="@drawable/ic_star_full" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Star"
                android:src="@drawable/ic_star_full" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Star"
                android:src="@drawable/ic_star_full" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Star"
                android:src="@drawable/ic_star_full" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Star"
                android:src="@drawable/ic_star_full" />
        </LinearLayout>
    </LinearLayout>

    <!-- Comments Icon -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="Comment"
        android:src="@drawable/ic_comment" />
</LinearLayout>